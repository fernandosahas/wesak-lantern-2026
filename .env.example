# ═══════════════════════════════════════════════════════════════════
# B/Badulla Central College — Wesak Lantern Competition 2026
# Environment Variables
# Copy this file to .env.local and fill in your real values
# NEVER commit .env.local to git!
# ═══════════════════════════════════════════════════════════════════

# ─── APP ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# In production: https://your-vercel-domain.vercel.app

# ─── SUPABASE ────────────────────────────────────────────────────────
# Get from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...your_service_role_key
# ⚠️  NEVER expose SUPABASE_SERVICE_ROLE_KEY to the client!

# ─── CLOUDINARY ──────────────────────────────────────────────────────
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── ADMIN ───────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@wesak2026.lk
# ADMIN_EMAIL = the Supabase Auth user email that is allowed to access /admin

# ─── CLOUDFLARE TURNSTILE ────────────────────────────────────────────
# Get from: https://dash.cloudflare.com → Turnstile
# For local dev, use test keys: sitekey=1x00000000000000000000AA, secret=1x0000000000000000000000000000000AA
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ─── SECURITY ─────────────────────────────────────────────────────────
# Random secret used for IP hashing — generate with: openssl rand -hex 32
IP_HASH_SALT=your_very_long_random_string_at_least_32_characters

# ─── OPTIONAL ─────────────────────────────────────────────────────────
# NODE_ENV is set automatically by Next.js
# NODE_ENV=development
